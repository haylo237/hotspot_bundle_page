# ---------------------------------------------------------------------------
# HAYLO INTERNET — Backend environment variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
#
# Deployment topology:
#   Client ── MikroTik (10.5.50.1) ── Mini-server (10.5.50.2:3000) ── CamPay
# ---------------------------------------------------------------------------

# HTTP server
PORT=3000

# Public/LAN base URL where this backend is reachable (no trailing slash).
BASE_URL=http://10.5.50.2:3000

# Comma-separated list of extra origins allowed by CORS (optional).
# The defaults already cover the MikroTik and the mini-server itself.
# CORS_EXTRA_ORIGINS=http://example.local

# ---- CamPay ---------------------------------------------------------------
# Demo:       https://demo.campay.net
# Production: https://www.campay.net
CAMPAY_BASE_URL=https://demo.campay.net
CAMPAY_TOKEN=your_campay_permanent_token_here
CAMPAY_CURRENCY=XAF

# ---- MikroTik RouterOS API (LAN only) ------------------------------------
# The backend talks to the router over the local network — never over the
# public internet. 8728 = API, 8729 = API-SSL.
MIKROTIK_HOST=10.5.50.1
MIKROTIK_USER=hotspot-api
MIKROTIK_PASSWORD=your_password
MIKROTIK_PORT=8728

# Captive-portal URL on the router (used by the optional redirect helper).
HOTSPOT_LOGIN_URL=http://10.5.50.1/login

# If true, /api/hotspot/offers returns an error when the router is
# unreachable. If false (default), it returns the full offers list as a
# fallback so the portal is still usable.
OFFERS_STRICT=false

# Set to "development" to expose extra debug fields in /offers and diagnostics.
NODE_ENV=development

# Branding (used in receipts / CamPay descriptions)
ISP_NAME=HAYLO INTERNET
SUPPORT_PHONE=+237 6XX XXX XXX
SUPPORT_EMAIL=support@haylo.example
