# ---------------------------------------------------------------------------
# HAYLO INTERNET — Backend environment variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# HTTP server
PORT=3000

# Public base URL where this backend is hosted (no trailing slash).
# Used to build redirect URLs that come back through MikroTik.
BASE_URL=https://yourdomain.com

# ---- CamPay ---------------------------------------------------------------
# Demo:       https://demo.campay.net
# Production: https://www.campay.net  (or as provided by CamPay)
CAMPAY_BASE_URL=https://demo.campay.net
CAMPAY_TOKEN=your_campay_permanent_token_here
CAMPAY_CURRENCY=XAF

# ---- MikroTik RouterOS API -----------------------------------------------
# Use the API port (default 8728). Use 8729 for API-SSL.
MIKROTIK_HOST=192.168.88.1
MIKROTIK_USER=admin
MIKROTIK_PASSWORD=your_router_password
MIKROTIK_PORT=8728

# URL of the MikroTik hotspot login page (used in redirects back to portal).
# Usually the captive portal IP/hostname assigned by RouterOS.
HOTSPOT_LOGIN_URL=http://10.5.50.1/login

# Branding (used in receipts / Campay descriptions)
ISP_NAME=HAYLO INTERNET
SUPPORT_PHONE=+237 6XX XXX XXX
SUPPORT_EMAIL=support@haylo.example
